		controlgettext,text,,% "ahk_id " node[0].hwnd


		str:=node[0].hwnd "|" Control_GetClassNN(win,node[0].hwnd) "|" text "`n"


		for k,v in node {


			if k


				str.="`t" this.childrenTreeStr(v,win)


