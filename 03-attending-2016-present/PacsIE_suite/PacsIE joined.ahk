				arr["" labNo,"regDate"]:=(match3+1911) match4 match5


				arr["" labNo,"regTime"]:="" match6


				arr["" labNo,"reportDate"]:=(match7+1911) match8 match9


				arr["" labNo,"reportTime"]:="" match10


				


				continue


			}


			


