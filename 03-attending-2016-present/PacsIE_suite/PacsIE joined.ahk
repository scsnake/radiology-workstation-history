		return


	


	arr:=[]


	;~ screen:=0,x:=0,y:=0,xMax:=0,yMax:=0


	for k,v in getControls(impaxHwnd)


		if RegExMatch(v.ClassNN,"AfxWnd90u\d+") && RegExMatch(v.text,"Screen_(\d+)_format_\d+_Position_(\d)_(\d)",match) {


