}





filterDuplicate(str,del="`n"){


	arr:=[]


	loop,parse,str,%del%


		if (trim(a_loopfield)!="" && regexmatch(a_loopfield,"(\d{8}[^:]+: )?([^\r\n]+)",match)  && !instr(match2,"no"))


			arr["" match2].=RegExReplace(match1,":","")


	str:=""


	for k,v in arr


		str.=substr(v,1,-1) ": " k "`n"


	


	return substr(str,1,-1)


}





