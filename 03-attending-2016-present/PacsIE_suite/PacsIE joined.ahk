;					If ( Content_Length < Do_File_Upload )


;						MyErrors .= "`nThe range specified for the partial file upload is invalid: file size (" Content_Length ") is less than " Do_File_Upload - 1 "."


;					Else If ( 1 < Do_File_Upload )


