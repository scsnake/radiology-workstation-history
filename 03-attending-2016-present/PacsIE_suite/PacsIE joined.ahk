					SplitPath, file_ext, file_ext


					StringLeft, file_ext, file_ext, InStr( file_ext "?", "?" ) - 1


					output_file_path .= ( SubStr( output_file_path, 0 ) = "\" ? "" : "\" )


					. ( file_ext = "" ? "HTTPRequest " A_Year "-" A_MM "-" A_DD "_" SubStr( A_Now A_MSec, 9 ) ".txt" : file_ext )


				}


				Else


