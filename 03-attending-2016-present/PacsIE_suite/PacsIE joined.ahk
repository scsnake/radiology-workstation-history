	arr.year:=match1


	arr.month:=match2


	arr.day:=match3


	arr.hour:=match4


	arr.minute:=match5


	arr.second:=match6


	arr.zone:=match7


	arr.dateStr:=match1 fill0(match2) fill0(match3)


	arr.timeStr:=fill0(match4) fill0(match5) fill0(match6)


	arr.str:=arr.dateStr arr.timeStr


	return arr


}





