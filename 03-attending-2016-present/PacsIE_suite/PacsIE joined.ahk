		StringLeft, Content_Type, Content_Type, InStr( Content_Type ";", ";" ) - 1


		If !( pos := InStr( Content_Type, "text/" ) = 1 )


			Loop, Parse, Text_Content_Subtypes, /


				If ( pos |= 0 < InStr( Content_Type, "/" A_LoopField ) )


					Break





