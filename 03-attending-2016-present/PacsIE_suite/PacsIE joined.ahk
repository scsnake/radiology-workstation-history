class patientLabDataRecent {


	__New(html){


		i:=0,arr:=[]


		while i:=RegExMatch(html,"is)<td>([^<]*)<\/td>",match,i+1) {


			if a_index<10


				continue


			


			if mod(a_index,3)=1


				item:=match1


			else if mod(a_index,3)=2


				value:=match1


			else {


				date:=match1


				arr[item,"" date]:=value


			}


		}


		this.lab:=arr


	}


	


	getValue(labName){


		value:=[]


		for k,v in this.lab {


			if (isobject(labName)) {


				for m,n in labName


					if(k=n)


						for x,y in v


							value.push(array(x,y))


			}else if(k=labName)


				for x,y in v


					value.push(array(x,y))


		}


		return value


	}


	


}




















