;   <Edit_GetText> function (WM_GETTEXT message) is used to collect the desired


;   range of characters.


;


;-------------------------------------------------------------------------------


Edit_GetTextRange(hEdit,p_Min=0,p_Max=-1)


    {


    Return SubStr(Edit_GetText(hEdit,p_Max),p_Min+1)


    }











