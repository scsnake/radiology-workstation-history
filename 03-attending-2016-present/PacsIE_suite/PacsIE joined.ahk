PacsWebDownloadJpeg2(url,AccNo,chartNo,fileName="",folder="",PicWidth="",loginId="",loginPw="",retry=3,fileSize=100,first=1){


	


	;~ global JSESSIONID,JSESSIONSSO


	


	;~ if(!JSESSIONID || !JSESSIONSSO)


