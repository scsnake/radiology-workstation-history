		}


	}


	return output


	


}





PacsWebInfoFlatten(byref result){


	output:=[]


	for k,v in result


		if isobject(v)


			for x,y in v


				if isobject(y) && y.hasKey("ObjectUID")


					output.push(y)


	return output


}


PacsWebUrlTrans(url){


	regexmatch(url,"is)(?<=studyUID=)[\d\.]+",studyUID)


	regexmatch(url,"is)(?<=seriesUID=)[\d\.]+",seriesUID)


	regexmatch(url,"is)(?<=objectUID=)[\d\.]+",objectUID)


	return "http://pacsmobile.hospital-n.local/wado/?v=2.0.SU3.3&requestType=XERO" (studyUID?"&studyUID=" studyUID:"") (seriesUID?"&seriesUID=" seriesUID:"") (objectUID?"&objectUID=" objectUID:"") "&language=zh_TW&ae=local"


}





