      )


      


   if ( p_reserved )


      unsafe = %unsafe%24262B2C2F3A3B3D3F40


   


   if ( p_encode )


      loop, % StrLen( unsafe )//2


      {


         StringMid, token, unsafe, A_Index*2-1, 2


