;						hbuffer .= "Content-Range: bytes " Do_File_Upload - 1 "-" Content_Length - 1 "/" Content_Length "`r`n"


				}


				Else MyErrors .= "`nFile upload failed: the file """ Upload_File_Path """ could not be found."


