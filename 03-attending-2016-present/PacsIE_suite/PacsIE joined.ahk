// Simple access to global variable $$                                      //


jQ(path, val = "") {





    global $$


    tempobj := $$





    last := (instr(path, ".")


        ? substr(path, 1+instr(path, ".", false, -1))


        : path)





    Loop, Parse, path, \.


    {


        if (val != "") {


            if (last = A_loopfield){


                tempObj[A_loopfield] := val


                continue


            } else if (!tempObj[A_Loopfield])


                tempObj[A_loopfield] := Object()


        } else if (!tempObj)


            break


