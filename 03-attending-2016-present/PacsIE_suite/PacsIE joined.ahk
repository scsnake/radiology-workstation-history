					|| ( pos := InStr( security_flags_list, "|SECURITY_FLAG_" options "|" ) )


				{


					StringLeft, options, security_flags_list, pos


					StringReplace, options, options, ., ., UseErrorLevel


					If ( flag_plus_or_minus = "+" )


