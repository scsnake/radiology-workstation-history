waitLoaded(byref pwb,judge="",waitSeconds=30,firstDelay=200){


	sleep % firstDelay


	if !isobject(judge) {


		while pwb.busy {


			if (a_index>waitSeconds*10)


				return 0


			sleep 100


		}


		return 1


	}else{


		while !judge.(pwb) {


			if (a_index>waitSeconds*10)


				return 0


			sleep 100


		}


		return 1


	}


}





