Edit_SetRect(hEdit,p_Left,p_Top,p_Right,p_Bottom)


    {


    Static EM_SETRECT:=0xB3





    VarSetCapacity(RECT_Structure,16,0)


    NumPut(p_Left,  RECT_Structure,0,"Int")


