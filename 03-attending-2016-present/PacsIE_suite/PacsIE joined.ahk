		If ( Do_Binary_Down ) || !( pos ) || ( Convert_POST_To_Codepage = MyACP )


		{


			VarSetCapacity( In_POST__Out_Data, size + 2, 0 )


			DllCall( "RtlMoveMemory", Ptr, &In_POST__Out_Data, Ptr, &dbuffer, "Int", size )


			If ( pos )


				VarSetCapacity( In_POST__Out_Data, -1 )


