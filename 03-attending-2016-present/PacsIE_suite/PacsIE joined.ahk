	Do_Callback := 0


	Do_NonBinary_Up := 0


	Do_Binary_Down := 0


	Do_Up_MD5_Hash := 0


	Do_Dn_MD5_Hash := 0


	Do_File_Upload := 0


	Do_Multipart := 0


	Do_Download_To_File := 0


	Do_Download_Resume := 0


	Do_Legacy_Dual_Output := 0


	Agent := Default_Agent


	Accept_Types := Default_Accept_Types


	Multipart_Boundary := ""


	proxy_bypass := ""


	Method_Verb := ""


	MyErrors := ""


	dbuffsz := 0


	port := 0


	dtsz := 0


