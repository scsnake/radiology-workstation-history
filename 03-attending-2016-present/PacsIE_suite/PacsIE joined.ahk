   WordWrap(On) { ; Turn wordwrapping on/off


      ; EM_SCROLLCARET = 0xB7, EM_SETTARGETDEVICE = 0x0448


      Sel := This.GetSel()


      SendMessage, 0x0448, 0, % (On ? 0 : -1), , % "ahk_id " . This.HWND


      This.SetSel(Sel.S, Sel.E)


