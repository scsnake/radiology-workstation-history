	If ( pos := InStr( host, "@" ) )


	{


		StringLeft, user, host, pos - 1


		StringTrimLeft, host, host, pos


		If ( pos := InStr( user, ":" ) )


		{


			StringTrimLeft, pass, user, pos


			StringLeft, user, user, pos - 1


